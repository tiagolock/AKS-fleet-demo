# Example Terraform variables file
# Copy this to terraform.tfvars and fill in your values

# Azure Provider Variables (should be set via environment variables in production)
# subscription_id = "your-subscription-id"
# tenant_id       = "your-tenant-id"
# client_id       = "your-client-id"
# client_secret   = "your-client-secret"

# AKS Cluster 1 Configuration (e.g., East US)
aks_cluster_1 = {
  name                = "aks-cluster-1"
  location            = "eastus"
  resource_group_name = "rg-aks-cluster-1"
  kubernetes_version  = "1.28"
}

# AKS Cluster 2 Configuration (e.g., East US 2)
aks_cluster_2 = {
  name                = "aks-cluster-2"
  location            = "eastus2"
  resource_group_name = "rg-aks-cluster-2"
  kubernetes_version  = "1.28"
}

# AKS Fleet Manager Configuration
fleet_name               = "fleet-manager"
fleet_location           = "eastus"
fleet_resource_group_name = "rg-aks-fleet"

# Jump Host Configuration
enable_jump_host         = true
jump_host_vm_size        = "Standard_B2s"
jump_host_username       = "azureuser"

# Network Configuration
vnet_address_space        = "10.0.0.0/16"
aks_subnet_address_prefix = "10.0.1.0/24"
jump_host_subnet_address_prefix = "172.16.0.0/24"

# Tags
tags = {
  Environment = "dev"
  Project     = "AKS-Fleet-Demo"
  ManagedBy   = "Terraform"
}
